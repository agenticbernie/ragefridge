# Environment variables must be supplied by the shell or hosting platform.
# npm start does not automatically load this file.
PORT=10000
PUBLIC_ORIGIN=http://localhost:10000

# Keep disabled until the Fuji deployment and operator configuration are verified.
CHAIN_ENABLED=false
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_TOKEN_ADDRESS=0xdB327028a1F07E6aAC4B95b3cF23bC4239Dc62fc
CHAIN_ESCROW_ADDRESS=0xCbB37BE2c4df698FcBBb41B44A3d1cbBeFEF7943
# Read-only deployment verification uses public expectations, not private keys.
CHAIN_EXPECTED_CREATOR=0xD7A9788d08140237abBc482BF7981647Eb0419A1
CHAIN_EXPECTED_SIGNERS=0x9DDCeb36F344b885Fe9D49fB5518a4643d4fafB6,0x823C7C16eE96b840A83b9bC0612a7C80ee10B632,0xBf3Ce627AF783d46fcC9207EeF4B24EfB03127Ce
CHAIN_STAKE=10000000000000000000
CHAIN_CREATOR_KEY=
CHAIN_SIGNER_KEYS=
CHAIN_ALLOWED_PLAYERS=
# Private, persistent, single-writer directory. Never put this under public/.
CHAIN_STATE_DIR=
